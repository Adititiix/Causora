# Copy to .env and edit:  Copy-Item .env.example .env   (PowerShell)
# Never commit .env (it is in .gitignore). The values below are local placeholders, not
# real credentials: change POSTGRES_PASSWORD and keep DATABASE_URL in sync with it.

# ---- Postgres (Day 1) ----
POSTGRES_USER=copilot
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=incident_copilot
# Host port of the Docker database. 5434 avoids clashing with a Postgres already installed
# on your machine (a native PostgreSQL service often takes 5432 or 5433).
POSTGRES_PORT=5434

# Used when running Python on your host (tests, scripts, uvicorn outside Docker).
# Inside Docker Compose the api service overrides the host to "db" automatically.
# The password and port here MUST match POSTGRES_PASSWORD and POSTGRES_PORT above.
DATABASE_URL=postgresql://copilot:change-me-locally@localhost:5434/incident_copilot

# ---- API (Day 1) ----
API_PORT=8000
LOG_LEVEL=INFO

# ---- Embeddings (Day 2) ----
# Free, local, no API key. 384 dimensions. Changing the model/dimension later
# requires a schema migration because chunks.embedding is vector(384).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Where the model files are cached (~67 MB). Docker overrides this to /models, a named
# volume, so rebuilding the image does not re-download the model.
EMBEDDING_CACHE_DIR=.cache/fastembed

# ---- Ingestion (Day 2) ----
# Corpus root; documents.path is stored relative to it. Docker overrides this to /app/data.
DATA_DIR=data

# ---- Reranker (Day 5) ----
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- LLM generation (Day 3). Gemini has a free tier. Leave blank until then. ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model names change often (gemini-2.0-flash was shut down on 2026-06-01). Before Day 3,
# check https://ai.google.dev/gemini-api/docs/pricing for models marked "Free of charge"
# and https://ai.google.dev/gemini-api/docs/deprecations for shutdown dates.
# As of 2026-10-16 free-tier text models include: gemini-3.8-flash, gemini-3.6-flash,
# gemini-3.5-flash-lite, gemini-3.1-flash-lite. Flash-lite is easier on rate limits for
# bulk eval runs.
LLM_MODEL=gemini-3.8-flash
# Per-call timeout (Gemini also gets it as its server deadline; a slower call comes back as
# HTTP 504 "Deadline expired"), and retries with jittered backoff for transient failures
# (HTTP 408/429/500/502/503/504 and network timeouts). 400/401/403/404 are never retried.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# Overall bound for one answer: all attempts and waits together. Keep it below
# UI_REQUEST_TIMEOUT_SECONDS so the API reports the failure before the page gives up.
LLM_TOTAL_TIMEOUT_SECONDS=60

# ---- /ask (Day 3) ----
# Chunks retrieved and shown to the LLM (a request's top_k overrides it, 1-20).
ASK_TOP_K=8
# vector                  = cosine similarity to the question only
# vector+error_link       = also follows the exception line of retrieved failed logs to the
#                           matching runbook (deterministic second vector search; see README)
# vector+date             = vector, but when the question names ONE unambiguous date, log
#                           chunks from other dates are dropped (other sources never are)
# vector+error_link+date  = both (the default until 2026-10-28)
# Evidence selection (retrieval/evidence.py) on top of vector+error_link+date:
# vector+error_link+evidence+date = anchor-preserving links, at most 2 chunks per document,
#                           and the Resolution section of a matched runbook for failure/fix
#                           questions. Single steps: +anchors+date, +resolution+date,
#                           +diverse+date (in place of +evidence+date).
#                           +evidence+context+date also adds the traceback chunk of the
#                           failed log a dated question asks about.
# vector+error_link+evidence+context+scoped+date = the DEFAULT: +evidence+context with the
#                           per-document cap only for dated-log questions. On the 50 seed
#                           questions it refused 0/44 answerable questions (the previous
#                           default: 12/44 and 15/44) and still refused 6/6 unanswerable ones.
RETRIEVER=vector+error_link+evidence+context+scoped+date
# Pre-LLM refusal gate: if the best chunk's cosine similarity is below this, /ask answers
# "Not enough evidence to determine the cause" without calling the LLM. Calibrated on the
# seed questions (python -m incident_copilot.evaluation.retrieval_smoke). It is a weak
# signal: it cannot catch every unanswerable question, the model's own
# insufficient_evidence flag handles the rest. 0.72 = midpoint between the highest blocked
# unanswerable (0.700) and the lowest answerable (0.736) seed question with bge-small-en-v1.5;
# it blocks 5/6 unanswerable and 0/44 answerable. Recalibrate if the model or data change.
MIN_SIMILARITY=0.72
# Clarification for vague questions refused by the gate above ("why did the payment fail?"):
# Causora asks which failure is meant when 2..CLARIFY_MAX_CANDIDATES distinct incidents or
# failed runs have evidence at or above CLARIFY_MIN_SIMILARITY, and the question names no
# subject of its own. The user's choice is answered only if it then passes MIN_SIMILARITY.
CLARIFY_MIN_SIMILARITY=0.67
CLARIFY_MAX_CANDIDATES=5

# ---- Streamlit UI ----
# Base URL of the running FastAPI app that the chat page calls (match API_PORT, or the
# --port you gave uvicorn). The UI sends questions only to this API, never to Gemini.
UI_API_URL=http://127.0.0.1:8000
# How long the page waits for one /ask answer before showing a timeout.
UI_REQUEST_TIMEOUT_SECONDS=120

# ---- Retrieval / abstention knobs (Day 4-5) ----
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
# Reserved for the reranker-score gate (Day 5); /ask currently uses MIN_SIMILARITY.
ABSTAIN_THRESHOLD=0.0
